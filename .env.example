# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables. Never commit real values.

# Supabase (Project Settings > API). The anon key is public by design;
# access is enforced by the portal schema's RPCs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The live URL, e.g. https://your-portal.vercel.app. Magic links point here.
NEXT_PUBLIC_SITE_URL=

# Where tasks live. Leave empty to keep them in Supabase, on the portal's Tasks
# page. Set to "asana" to use Asana; the ASANA_* values below are then required.
TASK_BACKEND=

# Asana personal access token from your PERSONAL account
# (My settings > Apps > Developer apps). Server-side only.
ASANA_TOKEN=

# The personal workspace's gid. Every project below must belong to it,
# or the portal refuses to read it. This keeps work data out.
ASANA_WORKSPACE_GID=

# Project gids (the number in the project's URL).
ASANA_PROJECT_PMPP=
ASANA_PROJECT_AXLER=
ASANA_PROJECT_RENDERING=
ASANA_PROJECT_WEEKLY_LOG=

# Optional. Used for "today" and the Monday-to-Sunday week.
# An IANA name such as Europe/London. Defaults to UTC.
PORTAL_TIMEZONE=
# Optional. Planned study hours per week, for Today's bar and the Sunday update.
# It counts only until a pace is set on the Study page, which then replaces it.
PORTAL_WEEKLY_HOURS_TARGET=

# "on" shows Continue with Google on the sign-in page. Turn on the Google
# provider in Supabase first (docs/SETUP.md, section 3).
GOOGLE_SIGN_IN=

# Google Calendar, for life blocks (lunch, gym, ...). Optional: the schedule
# works without it, showing only Asana work. See docs/SETUP.md, section 4.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
GOOGLE_TOKEN_KEY=
# Defaults to your main calendar. Use a calendar's id to keep life blocks separate.
GOOGLE_CALENDAR_ID=

# Claude API (optional): reads a job advert you paste on Jobs, and any later work the
# portal does with no chat open. An API key from the Claude Console organisation linked
# to the Max plan, whose monthly credit pays for it (docs/SETUP.md, "Claude API").
# Vercel only: Production, marked sensitive. Never in GitHub or the repo.
ANTHROPIC_API_KEY=
# Only for tests: a fake Claude API (the end-to-end suite runs one). Leave empty.
ANTHROPIC_BASE_URL=
# Only for tests: the one local origin the suite serves made-up job pages from, which
# the job page reader may fetch although it isn't public. Ignored on Vercel. Leave empty.
JOB_PAGES_TEST_ORIGIN=

# Claude connector (optional). Claude's callbacks on claude.ai and claude.com
# are always allowed; add other OAuth redirect URIs here, comma-separated.
MCP_EXTRA_REDIRECT_URIS=

# Error tracking is always on in production (VERCEL_ENV=production), where errors
# are stored for the factory to file as bug issues (docs/FACTORY.md). "on" turns it
# on elsewhere too; the end-to-end suite uses that. Leave empty locally.
ERROR_REPORTING=

# Money: the bank feed (optional). Lunch Flow Personal API key, from a REST API
# destination limited to your current account. Vercel only: Production, marked
# sensitive. Never in the database, the repo or the browser. See docs/SETUP.md.
LUNCHFLOW_API_KEY=
# Only for tests: a fake Lunch Flow (the end-to-end suite runs one). Leave empty.
LUNCHFLOW_BASE_URL=
# The scheduled bank sync (vercel.json crons), Vercel only, each any long random
# text (openssl rand -hex 32). Vercel Cron sends CRON_SECRET; the sync then proves
# itself to the database with MONEY_SYNC_KEY, whose hash you register on Money.
CRON_SECRET=
MONEY_SYNC_KEY=
