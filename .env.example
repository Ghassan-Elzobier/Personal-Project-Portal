# Copy to .env.local for local development. On Vercel, set these in
# Project Settings > Environment Variables. Never commit real values.

# Supabase (Project Settings > API). The anon key is public by design;
# access is enforced by the portal schema's RPCs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The live URL, e.g. https://your-portal.vercel.app. Magic links point here.
NEXT_PUBLIC_SITE_URL=

# Asana personal access token from your PERSONAL account
# (My settings > Apps > Developer apps). Server-side only.
ASANA_TOKEN=

# The personal workspace's gid. Every project below must belong to it,
# or the portal refuses to read it. This keeps work data out.
ASANA_WORKSPACE_GID=

# Project gids (the number in the project's URL).
ASANA_PROJECT_PMPP=
ASANA_PROJECT_AXLER=
ASANA_PROJECT_RENDERING=
ASANA_PROJECT_WEEKLY_LOG=

# Optional. Used for "today" and the Monday-to-Sunday week.
# An IANA name such as Europe/London. Defaults to UTC.
PORTAL_TIMEZONE=
# Optional. Planned study hours per week, shown in status drafts.
PORTAL_WEEKLY_HOURS_TARGET=
