{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "regions": ["lhr1"],
  "crons": [
    { "path": "/api/money/sync", "schedule": "30 5 * * *" },
    { "path": "/api/money/sync", "schedule": "30 10 * * *" },
    { "path": "/api/money/sync", "schedule": "30 15 * * *" },
    { "path": "/api/money/sync", "schedule": "30 20 * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
