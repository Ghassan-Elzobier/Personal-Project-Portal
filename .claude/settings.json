{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "env": { "NEXT_TELEMETRY_DISABLED": "1" },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm ci*)",
      "Bash(npx playwright *)",
      "Bash(npx prettier *)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx knip*)",
      "Bash(npx next build*)",
      "Bash(npx supabase status*)",
      "Bash(npx supabase start*)",
      "Bash(npx supabase stop*)",
      "Bash(npx supabase test db*)",
      "Bash(npx supabase migration new *)",
      "Bash(npx supabase db reset*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr create *)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)"
    ],
    "ask": [
      "Bash(npx supabase db push*)",
      "Bash(supabase db push*)",
      "Bash(npx vercel deploy --prod*)",
      "Bash(npx vercel --prod*)",
      "Bash(gh pr merge*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env.supabase.local)",
      "Read(./.env)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh", "timeout": 180 }
        ]
      }
    ]
  }
}
